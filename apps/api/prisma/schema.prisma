generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      UserRole @default(STAFF)
  isActive  Boolean  @default(true)
  tenantId  Int      @default(1)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  parentId  Int?
  parent    Tenant?  @relation("TenantTree", fields: [parentId], references: [id])
  children  Tenant[] @relation("TenantTree")
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  tenantId    Int       @default(1)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Product {
  id              Int             @id @default(autoincrement())
  /// Tên sản phẩm
  name            String
  /// Đơn vị tính
  unit            String
  /// Phân cấp
  classification  String?
  /// Tổng số lượng
  quantity        Int             @default(0)
  /// Nơi cất giữ
  storageLocation String?
  /// Ghi chú
  note            String?
  /// Xuất xứ
  origin          String?
  /// Lịch sử sử dụng
  usageHistory    String?
  /// Tài liệu liên quan
  documents       String?
  image           String?
  imageFileId     String?
  categoryId      Int
  tenantId        Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category        @relation(fields: [categoryId], references: [id])
  details         ProductDetail[]
  registrations   Registration[]
  transfers       Transfer[]
  ammunitions     Ammunition[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Ammunition {
  id             Int      @id @default(autoincrement())
  productId      Int
  warehouseId    Int?
  batch          String
  quantity       Int
  unit           String   @default("viên")
  productionYear Int
  tenantId       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id])
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
  transfers      Transfer[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([productId, tenantId])
  @@index([warehouseId, tenantId])
}

model Registration {
  id           Int                @id @default(autoincrement())
  ownerId      Int
  detailId     Int
  registeredAt DateTime           @default(now())
  status       RegistrationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  productId    Int?
  tenantId     Int                @default(1)
  detail       ProductDetail      @relation(fields: [detailId], references: [id])
  owner        Owner              @relation(fields: [ownerId], references: [id])
  product      Product?           @relation(fields: [productId], references: [id])

  @@unique([id, tenantId])
}

model Owner {
  id            Int             @id @default(autoincrement())
  /// Họ tên
  fullName      String
  /// Cấp bậc
  rank          String?
  /// Chức vụ
  position      String?
  /// Đơn vị
  department    String?
  /// SĐT
  phone         String?
  tenantId      Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  details       ProductDetail[]
  registrations Registration[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model ProductDetail {
  id                Int            @id @default(autoincrement())
  productId         Int
  ownerId           Int?
  ownerName         String?
  position          String?
  serialNumber      String?
  level             String?
  accessory         String?
  equipment         String?
  status            String         @default("AVAILABLE")
  militaryEquipment String?
  importOrder       String?
  receivedDate      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  warehouseId       Int?
  tenantId          Int            @default(1)
  owner             Owner?         @relation(fields: [ownerId], references: [id])
  product           Product        @relation(fields: [productId], references: [id])
  warehouse         Warehouse?     @relation(fields: [warehouseId], references: [id])
  registrations     Registration[]
  repairRecords     RepairRecord[]
  transfers         Transfer[]

  @@unique([id, tenantId])
}

model RepairRecord {
  id              Int       @id @default(autoincrement())
  productDetailId Int
  damageStatus    String?
  cause           String?
  repairStartDate DateTime?
  severity        String?
  repairUnit      String?
  receivedDate    DateTime?
  note            String?
  image           String?
  imageFileId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        Int       @default(1)

  productDetail ProductDetail @relation(fields: [productDetailId], references: [id])

  @@unique([id, tenantId])
}

model Warehouse {
  id          Int             @id @default(autoincrement())
  name        String
  tenantId    Int             @default(1)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  details     ProductDetail[]
  ammunitions Ammunition[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model AppLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  tenantId  Int      @default(1)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
}

model Transfer {
  id              Int            @id @default(autoincrement())
  productId       Int
  productDetailId Int?
  ammunitionId    Int?
  quantity        Int             @default(1)
  fromTenantId    Int
  toTenantId      Int
  toUserId        Int?
  toWarehouseId   Int
  approvalTenantId Int            @default(1)
  approvalUserId   Int            @default(1)
  status          TransferStatus @default(PENDING)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenantId        Int            @default(1)
  product         Product        @relation(fields: [productId], references: [id])
  productDetail   ProductDetail?  @relation(fields: [productDetailId], references: [id])
  ammunition      Ammunition?    @relation(fields: [ammunitionId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([toTenantId, status])
  @@index([ammunitionId, status])
}

enum UserRole {
  SYSADMIN
  ADMIN
  STAFF
  USER
}

enum RegistrationStatus {
  ACTIVE
  RETURNED
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}
